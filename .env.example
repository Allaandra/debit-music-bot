# Discord Bot Settings
DISCORD_TOKEN=your_token_here
DISCORD_CLIENT_ID=your_client_id_here
DISCORD_CLIENT_SECRET=your_client_secret_here

# Security Settings
# Секретный ключ для подписи JWT-сессий пользователей
JWT_SECRET=super-secret-dnd-key-change-me-in-production

# Database (Prisma SQLite)
DATABASE_URL="file:./dev.db"

# Player Settings (local или lavalink)
PLAYER_ENGINE=local

# Настройка кукисов для YouTube (chrome, edge, firefox)
# Если не указано, бот будет искать cookies.txt в корне
# YOUTUBE_BROWSER_COOKIES=chrome
# YOUTUBE_COOKIES_FILE=cookies.txt
